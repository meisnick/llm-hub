{
  "_comment": "Copy to ~/.config/llmhub/hub.json and edit. Keys starting with _ are ignored. See docs/CONFIGURATION.md.",

  "listen_host": "0.0.0.0",
  "listen_port": 8090,
  "state_dir": "~/.local/state/llmhub",
  "launchd_prefix": "local.llmhub",
  "server_plist_dir": "~/.config/llmhub/launchd",
  "python": "/usr/bin/python3",
  "load_timeout": 180,
  "default_model": null,
  "temp_command": null,
  "session_log": false,

  "models": [
    {
      "id": "TF-Qwen3.8-27B",
      "key": "tf-qwen",
      "engine": "tensorfold",
      "params": "27B",
      "size": "19.9 GB",
      "server_port": 8089,
      "proxy_port": 8096,
      "cwd": "~/TensorFold",
      "command": ["~/TensorFold/.venv/bin/tensorfold", "serve", "Vontra/Qwen3.8-27B-MLX-4bit",
                  "--drafter", "auto", "--host", "127.0.0.1", "--port", "{port}",
                  "--context", "65536", "--name", "TF-Qwen3.8-27B", "--no-update-check"]
    },
    {
      "id": "MTPLX-Qwen3.8-27B",
      "key": "mtplx",
      "engine": "mtplx",
      "params": "27B",
      "size": "21.0 GB",
      "server_port": 8088,
      "proxy_port": 8095,
      "command": ["/opt/homebrew/bin/mtplx", "serve",
                  "--model", "Youssofal/Qwen3.8-27B-MTPLX-Optimized-Speed-FP16",
                  "--port", "{port}", "--preserve-thinking", "off",
                  "--tool-prompt-mode", "native", "--no-auth"]
    },
    {
      "id": "Nemotron-3.5-Lightning-30B",
      "key": "nemotron",
      "engine": "llama.cpp",
      "params": "30B-A3B",
      "size": "33.6 GB",
      "server_port": 8097,
      "proxy_port": 8098,
      "env": {"DYLD_LIBRARY_PATH": "~/llama.cpp/build/bin"},
      "command": ["~/llama.cpp/build/bin/llama-server",
                  "-m", "~/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q8_0.gguf",
                  "--alias", "Nemotron-3.5-Lightning-30B", "--host", "127.0.0.1", "--port", "{port}",
                  "-c", "131072", "-ngl", "999", "--parallel", "1", "-b", "2048", "-ub", "2048",
                  "-fa", "on", "--reasoning-format", "none", "--metrics"]
    },
    {
      "id": "Qwopus3.8-27B-Flash",
      "key": "qwopus",
      "engine": "llama.cpp",
      "params": "27B",
      "size": "16.8 GB",
      "server_port": 8087,
      "proxy_port": 8094,
      "env": {"DYLD_LIBRARY_PATH": "~/llama.cpp/build/bin"},
      "command": ["~/llama.cpp/build/bin/llama-server",
                  "-m", "~/models/Qwopus3.8-27B-Flash-MTP-Q4_K_M.gguf",
                  "--alias", "Qwopus3.8-27B-Flash", "--host", "127.0.0.1", "--port", "{port}",
                  "-c", "131072", "-ngl", "999", "--parallel", "1", "-b", "2048", "-ub", "2048",
                  "-fa", "on", "--reasoning-format", "none", "--metrics"]
    },
    {
      "id": "Qwen3.8-27B-Uncensored",
      "key": "27b",
      "engine": "llama.cpp",
      "params": "27B",
      "size": "16.0 GB",
      "server_port": 8086,
      "proxy_port": 8093,
      "env": {"DYLD_LIBRARY_PATH": "~/llama.cpp/build/bin"},
      "command": ["~/llama.cpp/build/bin/llama-server",
                  "-m", "~/models/Qwen3.8-27B-Uncensored-Q4_K_M.gguf",
                  "--alias", "Qwen3.8-27B-Uncensored", "--host", "127.0.0.1", "--port", "{port}",
                  "-c", "131072", "-ngl", "999", "--parallel", "1", "-b", "2048", "-ub", "2048",
                  "-fa", "on", "--reasoning-format", "none", "--metrics"]
    },
    {
      "id": "K2-Horizon-MoVA-36B",
      "key": "36b",
      "engine": "llama.cpp",
      "params": "36B-A4B",
      "size": "21.0 GB",
      "server_port": 8085,
      "proxy_port": 8092,
      "env": {"DYLD_LIBRARY_PATH": "~/llama.cpp/build/bin"},
      "command": ["~/llama.cpp/build/bin/llama-server",
                  "-m", "~/models/K2-Horizon-MoVA-36B-A4B-Q4_K_M.gguf",
                  "--alias", "K2-Horizon-MoVA-36B", "--host", "127.0.0.1", "--port", "{port}",
                  "-c", "131072", "-ngl", "999", "--parallel", "1", "-b", "2048", "-ub", "2048",
                  "-fa", "on", "--reasoning-format", "none", "--reasoning-effort", "high", "--metrics"]
